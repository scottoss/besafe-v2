# ==========================================
# Dockerfile: VRChat Bot API & Worker Service
# ==========================================
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV SERVICE_NAME=vrchat-bot
ENV VRCHAT_BOT_PORT=3001

COPY package*.json ./
RUN npm ci --omit=dev

COPY services ./services
COPY server.ts ./server.ts

RUN npm install -g tsx

EXPOSE 3001

USER node

CMD ["tsx", "services/vrchat-bot/index.ts"]
