# ==========================================
# Dockerfile: Discord Bot Shard Worker Service
# ==========================================
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV SERVICE_NAME=discord-bot
ENV DISCORD_BOT_PORT=3002

# Install ffmpeg and build dependencies for native audio modules
RUN apk add --no-cache ffmpeg python3 make g++

COPY package*.json ./
RUN npm ci --omit=dev

COPY services ./services
COPY server.ts ./server.ts

RUN npm install -g tsx

EXPOSE 3002

USER node

CMD ["tsx", "services/discord-bot/index.ts"]
