# Service Mode ('all' | 'web-dashboard' | 'vrchat-bot' | 'discord-bot' | 'discord-sharder')
SERVICE_NAME=all

# Server & Service Ports
PORT=3000
VRCHAT_BOT_PORT=3001
DISCORD_BOT_PORT=3002

# Application & Service Discovery URLs
APP_URL=http://localhost:3000
VRCHAT_SERVICE_URL=http://localhost:3001
DISCORD_SERVICE_URL=http://localhost:3002

# Database
MONGO_URI=mongodb://localhost:27017/besafe
MONGODB_URI=mongodb://localhost:27017/besafe

# Discord Configuration & Sharding
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_SHARDING_MODE=stateful
SHARD_ID=0
SHARD_COUNT=1
TOTAL_SHARDS=1

# VRChat Bot Partitioning
VRC_INSTANCE_ID=0
VRC_TOTAL_INSTANCES=1

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Security Secrets
JWT_SECRET=
