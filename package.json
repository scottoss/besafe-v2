{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "start:dashboard": "SERVICE_NAME=web-dashboard tsx services/web-dashboard/index.ts",
    "start:vrchat": "SERVICE_NAME=vrchat-bot tsx services/vrchat-bot/index.ts",
    "start:discord": "SERVICE_NAME=discord-bot tsx services/discord-bot/index.ts",
    "start:discord:sharded": "SERVICE_NAME=discord-sharder tsx services/discord-bot/shard-manager.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.4.1",
    "motion": "^12.23.24",
    "nodemailer": "^8.0.5",
    "nsfwjs": "^4.4.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
